{
  "name": "llm-key-manager",
  "version": "1.0.0",
  "private": true,
  "description": "多平台大模型 API-KEY 集中管理工具（Vue3 + Electron 桌面端）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:icon": "python scripts/make-icon.py",
    "sync:backend": "node scripts/sync-backend.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c blue,green \"npm run dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "npm run build:vite && electron-builder",
    "build:win": "npm run build:vite && electron-builder --win nsis",
    "build:mac": "npm run build:vite && electron-builder --mac dmg",
    "build:linux": "npm run build:vite && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "dompurify": "^3.4.17",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.1",
    "marked": "^12.0.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.akmanager.app",
    "productName": "LLM密钥管理台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
